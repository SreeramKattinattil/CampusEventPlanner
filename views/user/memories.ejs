<%- include('../partials/userHeader', { user }) %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="flex">
  <!-- Sidebar is fixed, outside this main content -->
  <main class="flex-1 ml-64 p-6 bg-gradient-to-br from-gray-50 to-gray-100 min-h-screen">
    <div class="max-w-7xl mx-auto">
      <!-- Header Section -->
      <div class="mb-12 text-center">
        <h2 class="text-4xl md:text-5xl font-bold mb-4 bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">Event Memories</h2>
      </div>

      <% if (!mediaList || mediaList.length === 0) { %>
        <!-- Empty State -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-12 text-center max-w-2xl mx-auto">
          <div class="w-24 h-24 mx-auto mb-6 rounded-full bg-gray-100 flex items-center justify-center">
            <i class="fas fa-images text-gray-400 text-3xl"></i>
          </div>
          <h3 class="text-2xl font-semibold text-gray-700 mb-3">No memories yet</h3>
          <p class="text-gray-500 text-lg">Be the first to share your event memories!</p>
        </div>
      <% } else { %>
        <!-- Memory Cards Grid -->
        <div class="grid gap-8 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
          <% mediaList.forEach(post => { 
              const files = post.files && post.files.length ? post.files : [{ mediaType: post.mediaType, mediaUrl: post.mediaUrl }];
          %>
            <div class="bg-white rounded-2xl shadow-md overflow-hidden border border-gray-200 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
              <!-- Media Section with Swiper -->
              <div class="relative">
                <div class="swiper mySwiper">
                  <div class="swiper-wrapper">
                    <% files.forEach(file => { %>
                      <div class="swiper-slide">
                        <% if (file.mediaType === 'image') { %>
                          <img src="<%= file.mediaUrl %>" alt="Memory" class="w-full h-64 sm:h-72 md:h-64 lg:h-72 object-cover">
                        <% } else { %>
                          <video src="<%= file.mediaUrl %>" controls class="w-full h-64 sm:h-72 md:h-64 lg:h-72 object-cover"></video>
                        <% } %>
                      </div>
                    <% }) %>
                  </div>
                  <div class="swiper-pagination"></div>
                  <div class="swiper-button-next bg-white/80 backdrop-blur-sm rounded-full w-10 h-10 flex items-center justify-center shadow-md"></div>
                  <div class="swiper-button-prev bg-white/80 backdrop-blur-sm rounded-full w-10 h-10 flex items-center justify-center shadow-md"></div>
                  
                  <!-- Media type indicator -->
                  <% if (files.length > 0) { %>
                    <div class="absolute top-3 right-3 z-10 bg-black/70 text-white text-xs px-2 py-1 rounded-full flex items-center">
                      <% if (files[0].mediaType === 'image') { %>
                        <i class="fas fa-image mr-1"></i>
                      <% } else { %>
                        <i class="fas fa-video mr-1"></i>
                      <% } %>
                      <%= files.length %>
                    </div>
                  <% } %>
                </div>
              </div>

              <!-- Content Section -->
              <div class="p-5">
                <h3 class="text-gray-800 font-semibold text-lg mb-2 line-clamp-2"><%= post.caption || "Untitled Memory" %></h3>
                
                <!-- Event Name Only -->
                <div class="flex items-center text-sm text-gray-600 mt-3 pt-3 border-t border-gray-100">
                  <i class="fas fa-calendar-alt text-blue-500 mr-2 w-5"></i>
                  <span class="font-medium text-gray-800"><%= post.event?.name %></span>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.mySwiper').forEach(swiperEl => {
      new Swiper(swiperEl, {
        loop: false,
        spaceBetween: 0,
        slidesPerView: 1,
        pagination: {
          el: swiperEl.querySelector('.swiper-pagination'),
          clickable: true,
          dynamicBullets: true,
        },
        navigation: {
          nextEl: swiperEl.querySelector('.swiper-button-next'),
          prevEl: swiperEl.querySelector('.swiper-button-prev'),
        },
      });
    });
  });
</script>

<style>
  .swiper-button-next:after, .swiper-button-prev:after {
    font-size: 16px;
    color: #4b5563;
  }
  .swiper-pagination-bullet {
    background: rgba(255, 255, 255, 0.8);
  }
  .swiper-pagination-bullet-active {
    background: white;
  }
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
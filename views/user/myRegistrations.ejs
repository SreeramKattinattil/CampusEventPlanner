<%- include('../partials/userHeader', { user: user }) %>

<main class="ml-0 md:ml-60 p-4 md:p-8 bg-gray-100 min-h-screen">
  <h1 class="text-2xl font-bold mb-6">My Registrations</h1>

  <% if (registrations.length === 0) { %>
    <p>No registrations yet.</p>
  <% } else { %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <% registrations.forEach(reg => { %>
        <div class="bg-white p-6 rounded-xl shadow-md">

          <% if (reg.eventId) { %>
            <h2 class="text-xl font-semibold mb-2"><%= reg.eventId.name %></h2>
            <p class="mb-1"><strong>Date:</strong> <%= reg.eventId.date %></p>
            <p class="mb-1"><strong>Time:</strong> <%= reg.eventId.time %></p>
            <p class="mb-1"><strong>Venue:</strong> <%= reg.eventId.venue %></p>

            <p class="mb-1"><strong>Payment:</strong> 
              <% if (reg.paymentStatus === "paid") { %>
                <span class="text-green-600 font-bold">Paid</span>
              <% } else { %>
                <span class="text-red-600 font-bold">Pending</span>
              <% } %>
            </p>

            <% if (reg.qrCode) { %>
              <div class="mt-2">
                <p class="font-semibold">Your Ticket (QR):</p>
                <img src="<%= reg.qrCode %>" alt="QR Code for <%= reg.eventId.name %>" class="w-40 h-40 mt-1">
                <a href="<%= reg.qrCode %>" download="Ticket_<%= reg.eventId.name %>.png"
                   class="mt-2 inline-block bg-green-500 text-white px-4 py-2 rounded hover:bg-green-600">
                   Download QR
                </a>
              </div>
            <% } %>

            <p class="mt-2">
              <strong>Attendance Status:</strong> 
              <% if (reg.status === "attended") { %>
                <span class="text-green-600 font-bold">Attended</span>
              <% } else { %>
                <span class="text-gray-600 font-bold">Registered</span>
              <% } %>
            </p>

            <% if (reg.paymentStatus === "pending") { %>
              <a href="/user/event/<%= reg.eventId._id %>/payment" 
                 class="mt-2 inline-block bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600">
                Pay Now
              </a>
            <% } %>

            <!-- Feedback Form -->
            <% if (reg.paymentStatus === "paid" && reg.status === "attended") { %>
              <div class="mt-4 p-4 bg-gray-50 rounded-lg border border-gray-200">
                <h3 class="font-semibold text-gray-700 mb-2">Submit Feedback</h3>

                <% if (reg.feedback) { %>
                  <p><strong>Comment:</strong> <%= reg.feedback.comment %></p>
                <% } else { %>
                  <form action="/user/registration/<%= reg._id %>/feedback" method="POST">
                    <label class="block mb-1 text-gray-600">Comment:</label>
                    <textarea name="comment" rows="3" required
                              class="w-full mb-2 p-2 border border-gray-300 rounded"></textarea>

                    <button type="submit"
                            class="bg-green-500 text-white px-4 py-2 rounded hover:bg-green-600">
                      Submit Feedback
                    </button>
                  </form>
                <% } %>
              </div>
            <% } %>

          <% } else { %>
            <h2 class="text-xl font-semibold mb-2 text-red-500">Event Deleted</h2>
            <p class="text-gray-500">This event is no longer available.</p>
          <% } %>

        </div>
      <% }) %>
    </div>
  <% } %>
</main>

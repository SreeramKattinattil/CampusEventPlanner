<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Change Password</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              primary: "#2563EB",
            },
          },
        },
      };
    </script>
  </head>
  <body class="bg-gray-50 flex items-center justify-center min-h-screen px-4">
    <div class="w-full max-w-md bg-white p-8 rounded-2xl shadow-xl">
      <h2 class="text-3xl font-bold text-center text-primary mb-6">Change Password</h2>

      <!-- Show messages -->
      <% if (typeof error !== "undefined") { %>
        <p class="text-red-600 font-semibold mb-4 text-center"><%= error %></p>
      <% } %>
      <% if (typeof success !== "undefined") { %>
        <p class="text-green-600 font-semibold mb-4 text-center"><%= success %></p>
      <% } %>

      <!-- ✅ Corrected action -->
      <form action="/user/change-password" method="POST" class="space-y-6">
        <!-- Email -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
          <input
            type="email"
            name="email"
            required
            class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-primary"
          />
        </div>

        <!-- New Password -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">New Password</label>
          <input
            type="password"
            name="newPassword"
            required
            class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-primary"
          />
        </div>

        <!-- Re-enter New Password -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Re-enter New Password</label>
          <input
            type="password"
            name="confirmPassword"
            required
            class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-primary"
          />
        </div>

        <!-- Submit -->
        <button
          type="submit"
          class="w-full bg-primary text-white py-3 rounded-xl font-semibold hover:bg-blue-700 transition"
        >
          Update Password
        </button>

        <!-- Back to Login -->
        <p class="text-sm text-center text-gray-600">
          Remember your password?
          <a href="/login" class="text-primary font-semibold hover:underline">Login</a>
        </p>
      </form>
    </div>
  </body>
</html>

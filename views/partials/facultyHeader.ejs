<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Faculty Panel</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 text-gray-800">

  <!-- Sidebar -->
 <!-- Sidebar -->
<aside class="fixed inset-y-0 left-0 w-60 bg-gray-900 text-gray-200 flex flex-col py-6">
  <h2 class="text-center text-2xl font-bold text-white mb-8">Faculty</h2>
  <nav class="flex-1 space-y-2">
    <a href="/faculty/dashboard" class="flex items-center px-6 py-3 hover:bg-gray-800 rounded-md transition">
      🏠 <span class="ml-3">Dashboard</span>
    </a>
    <a href="/faculty/approved-events" class="flex items-center px-6 py-3 hover:bg-gray-800 rounded-md transition">
      📅 <span class="ml-3">Approved Events</span>
    </a>
    <a href="/faculty/create-event" class="flex items-center px-6 py-3 hover:bg-gray-800 rounded-md transition">
      ➕ <span class="ml-3">Create Event</span>
    </a>
    <a href="/faculty/pending-events" class="flex items-center px-6 py-3 hover:bg-gray-800 rounded-md transition">
      ⏳ <span class="ml-3">Pending Approval</span>
    </a>
    <a href="/faculty/rejected-events" class="flex items-center px-6 py-3 hover:bg-gray-800 rounded-md transition">
      ❌ <span class="ml-3">Rejected Events</span>
    </a>
    <a href="/faculty/students" class="flex items-center px-6 py-3 hover:bg-gray-800 rounded-md transition">
      🎓 <span class="ml-3">Students</span>
    </a>
    <a href="/faculty/add-event-coordinator" class="flex items-center px-6 py-3 hover:bg-gray-800 rounded-md transition">
      ➕ <span class="ml-3">Add Coordinator</span>
    </a>

    <!-- 🗣️ New Feedback Section -->
    <a href="/faculty/feedbacks" class="flex items-center px-6 py-3 hover:bg-gray-800 rounded-md transition">
      💬 <span class="ml-3">Feedbacks</span>
    </a>

    <!-- ✅ New: View Registrations -->
    <a href="/faculty/approved-events/registrations" class="flex items-center px-6 py-3 hover:bg-gray-800 rounded-md transition">
      📝 <span class="ml-3">View Registrations</span>
    </a>
      <a href="/faculty/transactions" class="flex items-center px-6 py-3 hover:bg-gray-800 rounded-md transition">
      📝 <span class="ml-3">View Registrations</span>
    </a>
  </nav>
</aside>


  <!-- Main Content -->
  <main class="ml-60 p-6">
    <div class="bg-white shadow rounded-lg px-6 py-4 flex justify-between items-center">
      <h1 class="text-xl font-semibold">Faculty Dashboard</h1>
      <div class="relative group">
        <button class="flex items-center space-x-2 focus:outline-none">
          <img src="https://i.pravatar.cc/40?img=3" alt="Faculty" class="w-10 h-10 rounded-full border">
          <span class="hidden md:inline font-medium"><%= faculty?.name || "Faculty" %></span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>
        <div class="absolute right-0 mt-2 w-48 bg-gray-800 text-gray-200 rounded-lg shadow-lg py-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition">
          <a href="/faculty/profile" class="block px-4 py-2 text-sm hover:bg-gray-700">Profile</a>
          <a href="/logout" class="block px-4 py-2 text-sm text-red-400 hover:bg-gray-700">Logout</a>
        </div>
      </div>
    </div>

    <!-- Dashboard content -->
    <div class="mt-6">
      <h2 class="text-2xl font-bold mb-4">Dashboard Content</h2>
    </div>
  </main>
</body>
</html>

<%- include("../partials/adminHeader", { user: admin, stats: stats, events: events }) %>

<div class="p-6 lg:ml-64">
  <div class="bg-white rounded-xl shadow-lg p-6 border border-gray-100">

    <!-- Title & Search -->
    <div class="flex flex-col md:flex-row justify-between items-center mb-6 gap-4">
      <h2 class="text-2xl font-bold text-gray-800 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-teal-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422M12 14v7m0-7L5.84 10.578" />
        </svg>
        Faculty List
      </h2>

      <!-- Search form -->
      <form method="GET" action="/admin/facultyList" class="flex items-center w-full md:w-auto">
        <input
          type="text"
          name="search"
          value="<%= typeof search !== 'undefined' ? search : '' %>"

          placeholder="Search by name or department..."
          class="w-full md:w-72 px-4 py-2 rounded-l-lg border border-gray-300 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none"
        />
        <button
          type="submit"
          class="bg-teal-500 text-white px-4 py-2 rounded-r-lg hover:bg-teal-600 transition"
        >
          Search
        </button>
      </form>
    </div>

    <!-- Empty state -->
    <% if (facultyList.length === 0) { %>
      <div class="text-center py-16">
        <p class="text-gray-500 text-lg mt-4">No faculty members found.</p>
      </div>
    <% } else { %>

      <!-- Table -->
      <div class="overflow-x-auto rounded-lg border border-gray-200">
        <table class="min-w-full bg-white text-sm text-gray-800">
          <thead class="bg-gray-50 border-b text-gray-600 uppercase text-xs tracking-wider">
            <tr>
              <th class="px-6 py-3 text-left">#</th>
              <th class="px-6 py-3 text-left">Name</th>
              <th class="px-6 py-3 text-left">Email</th>
              <th class="px-6 py-3 text-left">Department</th>
              <th class="px-6 py-3 text-center">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% facultyList.forEach((faculty, index) => { %>
              <tr class="hover:bg-gray-50 transition duration-200">
                <td class="px-6 py-4 text-gray-500"><%= index + 1 %></td>

                <!-- Name with search highlight -->
                <td class="px-6 py-4 font-semibold">
                  <% if (search && faculty.name.toLowerCase().includes(search.toLowerCase())) { %>
                    <%- faculty.name.replace(new RegExp(search, "gi"), match => `<span class="bg-yellow-200">${match}</span>`) %>
                  <% } else { %>
                    <%= faculty.name %>
                  <% } %>
                </td>

                <td class="px-6 py-4"><%= faculty.email %></td>

                <!-- Department with search highlight -->
                <td class="px-6 py-4">
                  <% if (search && faculty.department.toLowerCase().includes(search.toLowerCase())) { %>
                    <%- faculty.department.replace(new RegExp(search, "gi"), match => `<span class="bg-yellow-200">${match}</span>`) %>
                  <% } else { %>
                    <%= faculty.department %>
                  <% } %>
                </td>

                <td class="px-6 py-4 text-center">
                  <div class="flex items-center justify-center gap-4">
                    <!--<a href="/admin/edit-faculty/<%= faculty._id %>" class="text-blue-600 hover:text-blue-800 font-medium transition">Edit</a> -->
                    <form action="/admin/delete-faculty/<%= faculty._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this faculty?');">
                      <button type="submit" class="text-red-500 hover:text-red-700">Delete</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

    <% } %>
  </div>
</div>

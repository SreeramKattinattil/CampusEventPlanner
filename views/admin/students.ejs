<%- include('../partials/adminHeader', { admin: admin, stats: stats, events: events }) %>

<main class="ml-0 md:ml-64 p-6 bg-gray-100 min-h-screen">
  <div class="max-w-7xl mx-auto bg-white rounded-2xl shadow-lg p-6 border border-gray-200">

    <!-- Title & Search -->
    <div class="flex flex-col md:flex-row justify-between items-center mb-6 gap-4">
      <h2 class="text-2xl font-bold text-gray-800">Student List</h2>
      <form method="get" action="/students" class="flex items-center w-full md:w-auto">
        <input
          type="text"
          name="search"
          value="<%= search %>"
          placeholder="Search by name or department..."
          class="w-full md:w-72 px-4 py-2 border rounded-l-xl focus:ring-2 focus:ring-blue-400 focus:outline-none"
        />
        <button
          type="submit"
          class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-r-xl transition"
        >
          Search
        </button>
      </form>
    </div>

    <!-- Student Table -->
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-600">#</th>
            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-600">Name</th>
            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-600">Email</th>
            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-600">Mobile</th>
            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-600">College</th>
            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-600">Department</th>
            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-600">Semester</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% if (studentList.length === 0) { %>
            <tr>
              <td colspan="7" class="px-4 py-6 text-center text-gray-500">
                No students found.
              </td>
            </tr>
          <% } else { %>
            <% studentList.forEach((student, index) => { %>
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-2"><%= index + 1 %></td>
                <td class="px-4 py-2 font-medium text-gray-800"><%= student.name %></td>
                <td class="px-4 py-2 text-gray-600"><%= student.email %></td>
                <td class="px-4 py-2 text-gray-600"><%= student.mobile || '-' %></td>
                <td class="px-4 py-2 text-gray-600"><%= student.college || '-' %></td>

                <td class="px-4 py-2 text-gray-600"><%= student.department || '-' %></td>
                <td class="px-4 py-2 text-gray-600"><%= student.semester || '-' %></td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</main>

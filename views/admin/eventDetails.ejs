<%- include('../partials/adminHeader', { admin: admin, stats: stats, events: events }) %>

<main class="ml-60 p-6 bg-gray-100 min-h-screen">
  <div class="max-w-4xl mx-auto bg-white rounded-2xl shadow-lg p-6 border border-gray-200">

    <h2 class="text-2xl font-bold text-gray-800 mb-4">Event Details</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <h3 class="font-semibold text-gray-700">Event Name:</h3>
        <p class="text-gray-800"><%= event.name %></p>
      </div>

      <div>
        <h3 class="font-semibold text-gray-700">Date:</h3>
        <p class="text-gray-800">
          <%= new Date(event.date).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" }) %>
        </p>
      </div>

      <div>
        <h3 class="font-semibold text-gray-700">Time:</h3>
        <p class="text-gray-800"><%= event.time %></p>
      </div>

      <div>
        <h3 class="font-semibold text-gray-700">Venue:</h3>
        <p class="text-gray-800"><%= event.venue || '-' %></p>
      </div>

      <div>
        <h3 class="font-semibold text-gray-700">Status:</h3>
        <p class="text-gray-800"><%= event.status || 'Pending' %></p>
      </div>

      <div>
        <h3 class="font-semibold text-gray-700">Event Coordinator:</h3>
        <p class="text-gray-800"><%= event.createdBy?.name || '-' %></p>
      </div>

      <div>
        <h3 class="font-semibold text-gray-700">Assigned Faculty:</h3>
        <p class="text-gray-800">
          <% if (event.assignedFaculty) { %>
            <% if (Array.isArray(event.assignedFaculty)) { %>
              <%= event.assignedFaculty.map(f => f.name).join(', ') %>
            <% } else { %>
              <%= event.assignedFaculty.name %>
            <% } %>
          <% } else { %>
            -
          <% } %>
        </p>
      </div>

      <div class="md:col-span-2">
        <h3 class="font-semibold text-gray-700">Description:</h3>
        <p class="text-gray-800"><%= event.description || '-' %></p>
      </div>
    </div>

    <div class="mt-6">
      <a href="/admin/events" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-xl transition">
        Back to Events
      </a>
    </div>
  </div>
</main>

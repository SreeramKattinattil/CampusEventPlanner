<%- include('../partials/adminHeader', { admin: admin, stats: stats, events: events }) %>

<main class="ml-60 p-6 bg-gray-100 min-h-screen">
  <div class="max-w-7xl mx-auto bg-white rounded-2xl shadow-lg p-6 border border-gray-200">

    <!-- Title & Search -->
    <div class="flex flex-col md:flex-row justify-between items-center mb-6 gap-4">
      <h2 class="text-2xl font-bold text-gray-800">All Events</h2>
      <form method="get" action="/admin/events" class="flex items-center w-full md:w-auto">
        <input
          type="text"
          name="search"
          value="<%= searchQuery %>"
          placeholder="Search by name or venue..."
          class="w-full md:w-72 px-4 py-2 border rounded-l-xl focus:ring-2 focus:ring-blue-400 focus:outline-none"
        />
        <button
          type="submit"
          class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-r-xl transition"
        >
          Search
        </button>
      </form>
    </div>

    <!-- Events Table -->
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-600">#</th>
            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-600">Event Name</th>
            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-600">Date</th>
            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-600">Venue</th>
            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-600">Status</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% if (eventList.length === 0) { %>
            <tr>
              <td colspan="5" class="px-4 py-6 text-center text-gray-500">
                No events found.
              </td>
            </tr>
          <% } else { %>
            <% eventList.forEach((event, index) => { %>
              <tr class="hover:bg-gray-50 cursor-pointer" onclick="window.location='/admin/eventDetails/<%= event._id %>'">
                <td class="px-4 py-2"><%= index + 1 %></td>
                <td class="px-4 py-2 font-medium text-gray-800"><%= event.name %></td>
                <td class="px-4 py-2 text-gray-600"><%= new Date(event.date).toLocaleDateString() %></td>
                <td class="px-4 py-2 text-gray-600"><%= event.venue || '-' %></td>
                <td class="px-4 py-2 text-gray-600"><%= event.status || 'Pending' %></td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</main>

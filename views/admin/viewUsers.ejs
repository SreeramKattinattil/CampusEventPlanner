<%- include("../partials/adminHeader", { user: admin, stats: stats, events: events, pageTitle: "Registered Users" }) %>

<div class="ml-60 mt-10 p-6">
  <div class="max-w-6xl mx-auto bg-white rounded shadow p-6">
    <h2 class="text-2xl font-bold mb-4">Registered Users</h2>

    <% if (users.length === 0) { %>
      <p>No users found.</p>
    <% } else { %>
      <form action="/admin/deleteUsers" method="POST" id="deleteUsersForm">
        <div class="flex justify-between mb-4">
          <button type="button" id="toggleSelectBtn" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
            Select
          </button>
          <p class="text-gray-500 mt-2">Click "Select" to enable checkboxes</p>
        </div>

        <table class="w-full border-collapse">
          <thead>
            <tr class="bg-gray-200">
              <th class="border p-2 text-center">
                <input type="checkbox" id="selectAll" class="form-checkbox hidden">
              </th>
              <th class="border p-2 text-left">Name</th>
              <th class="border p-2 text-left">Email</th>
              <th class="border p-2 text-left">Department</th>
              <th class="border p-2 text-left">Semester</th>
              <th class="border p-2 text-center">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(user => { %>
              <tr class="hover:bg-gray-100">
                <td class="border p-2 text-center">
                  <input type="checkbox" name="userIds[]" value="<%= user._id %>" class="form-checkbox rowCheckbox hidden">
                </td>
                <td class="border p-2"><%= user.name %></td>
                <td class="border p-2"><%= user.email %></td>
                <td class="border p-2"><%= user.department %></td>
                <td class="border p-2"><%= user.semester %></td>
                <td class="border p-2 text-center">
                  <form action="/admin/deleteUsers" method="POST" class="inline-block singleDeleteForm">
                    <input type="hidden" name="userIds[]" value="<%= user._id %>">
                    <button type="submit" class="bg-red-500 text-white px-3 py-1 rounded hover:bg-red-700">
                      Delete
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>

        <div class="mt-4">
          <button type="submit" id="deleteSelectedBtn" class="bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700 hidden">
            Delete All
          </button>
        </div>
      </form>
    <% } %>
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const toggleSelectBtn = document.getElementById('toggleSelectBtn');
  const rowCheckboxes = document.querySelectorAll('.rowCheckbox');
  const selectAllCheckbox = document.getElementById('selectAll');
  const deleteSelectedBtn = document.getElementById('deleteSelectedBtn');

  let selecting = false;

  // Toggle select mode
  toggleSelectBtn.addEventListener('click', () => {
    selecting = !selecting;
    rowCheckboxes.forEach(cb => cb.classList.toggle('hidden', !selecting));
    selectAllCheckbox.classList.toggle('hidden', !selecting);
    deleteSelectedBtn.classList.toggle('hidden', !selecting);
    toggleSelectBtn.textContent = selecting ? 'Cancel' : 'Select';
  });

  // Select/Deselect all checkboxes
  selectAllCheckbox.addEventListener('change', function() {
    rowCheckboxes.forEach(cb => cb.checked = selectAllCheckbox.checked);
    updateDeleteButton();
  });

  // Update Delete button text
  rowCheckboxes.forEach(cb => cb.addEventListener('change', updateDeleteButton));
  function updateDeleteButton() {
    const anySelected = Array.from(rowCheckboxes).some(cb => cb.checked);
    deleteSelectedBtn.textContent = anySelected ? 'Delete All' : 'Delete Selected';
  }

  // Confirm before deleting selected users
  document.getElementById('deleteUsersForm').addEventListener('submit', function(e) {
    const anySelected = Array.from(rowCheckboxes).some(cb => cb.checked);
    if (!anySelected && selecting) {
      e.preventDefault();
      alert('Please select at least one user to delete.');
      return;
    }
    if (!confirm('Are you sure you want to delete the selected users? This action cannot be undone.')) {
      e.preventDefault();
    }
  });

  // Confirm single delete
  document.querySelectorAll('.singleDeleteForm').forEach(form => {
    form.addEventListener('submit', function(e) {
      if (!confirm('Are you sure you want to delete this user?')) {
        e.preventDefault();
      }
    });
  });
});
</script>

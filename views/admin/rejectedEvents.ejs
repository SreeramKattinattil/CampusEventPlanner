<%- include('../partials/adminHeader', { admin: admin, stats: stats }) %>


<main class="ml-60 p-6">
  <h1 class="text-2xl font-bold mb-6">Rejected Events</h1>

  <% if (events.length === 0) { %>
    <p>No rejected events found.</p>
  <% } else { %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% events.forEach(event => { %>
        <div class="bg-white p-4 rounded-lg shadow border-l-4 border-red-500">
          <h3 class="font-bold text-lg"><%= event.name %></h3>
          <p class="text-gray-600">By: <%= event.createdBy?.name || "N/A" %></p>
          <p class="text-gray-600">Department: <%= event.createdBy?.department || "N/A" %></p>
          <p class="text-sm text-gray-500 mt-2">Date: <%= new Date(event.date).toDateString() %></p>
          <p class="text-sm text-red-500 mt-2">Reason: <%= event.rejectionNote || "Not specified" %></p>
        </div>
      <% }) %>
    </div>
  <% } %>
</main>

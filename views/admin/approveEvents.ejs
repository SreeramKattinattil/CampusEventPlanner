<%- include('../partials/adminHeader', { admin: admin }) %>

<main class="ml-60 p-8 bg-gray-100 min-h-screen">
  <div class="bg-white p-6 rounded-2xl shadow-lg border border-gray-200">
    <div class="flex justify-between items-center mb-6">
      <h2 class="text-2xl font-bold text-gray-800">Event Approval List</h2>
      <form method="GET" action="/admin/eventList" class="flex">
        <input type="text" name="search" placeholder="Search event..." value="<%= searchQuery || '' %>"
          class="border border-gray-300 rounded-l-lg px-3 py-2 focus:ring-2 focus:ring-blue-400" />
        <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-r-lg hover:bg-blue-700">Search</button>
      </form>
    </div>

    <% if (!events || events.length === 0) { %>
      <p class="text-gray-500">No events found.</p>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse">
          <thead>
            <tr class="bg-gray-100 text-gray-700">
              <th class="py-3 px-4 text-left">Event Name</th>
              <th class="py-3 px-4 text-left">Faculty</th>
              <th class="py-3 px-4 text-left">Event Coordinator</th>
              <th class="py-3 px-4 text-left">Date</th>
              <th class="py-3 px-4 text-left">Status</th>
              <th class="py-3 px-4 text-center">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% events.forEach(event => { %>
              <tr class="border-b hover:bg-gray-50">
                <td class="py-3 px-4"><%= event.name %></td>
                <td class="py-3 px-4"><%= event.createdBy?.name || 'Unknown' %></td>
                <td class="py-3 px-4"><%= event.coordinator?.name || 'Unassigned' %></td>
                <td class="py-3 px-4"><%= new Date(event.date).toLocaleDateString() %></td>
                <td class="py-3 px-4">
                  <% if (event.status === 'approved') { %>
                    <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-sm">Approved</span>
                  <% } else if (event.status === 'rejected') { %>
                    <span class="bg-red-100 text-red-700 px-3 py-1 rounded-full text-sm">Rejected</span>
                  <% } else { %>
                    <span class="bg-yellow-100 text-yellow-700 px-3 py-1 rounded-full text-sm">Pending</span>
                  <% } %>
                </td>
                <td class="py-3 px-4 text-center space-x-2">
                  <% if (event.status !== 'approved' && event.status !== 'rejected') { %>
                    <form action="/admin/approve-event/<%= event._id %>" method="POST" class="inline">
                      <button type="submit" class="bg-green-600 text-white px-4 py-1 rounded hover:bg-green-700">Approve</button>
                    </form>
                    <form action="/admin/reject-event/<%= event._id %>" method="POST" class="inline">
                      <input type="text" name="reason" placeholder="Reason" required
                        class="border border-gray-300 rounded px-2 py-1 mr-1" />
                      <button type="submit" class="bg-red-600 text-white px-4 py-1 rounded hover:bg-red-700">Reject</button>
                    </form>
                  <% } else { %>
                    <span class="text-gray-400 italic">No actions</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</main>

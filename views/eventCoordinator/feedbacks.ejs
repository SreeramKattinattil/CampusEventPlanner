<%- include('../partials/eventCoordinatorHeader', { coordinator: coordinator }) %>

<main class="ml-0 md:ml-60 p-6 bg-gray-100 min-h-screen">
  <div class="max-w-5xl mx-auto bg-white rounded-2xl shadow-lg p-6 border border-gray-200">
    <h1 class="text-3xl font-bold text-gray-800 mb-6">Event Feedbacks</h1>

    <% if (registrations.length === 0) { %>
      <p class="text-gray-600 text-lg">No feedback received yet.</p>
    <% } else { %>
      <div class="space-y-4">
        <% registrations.forEach(reg => { %>
          <% if (reg.feedback && reg.feedback.comment) { %>
            <div class="bg-gray-50 p-4 rounded-xl shadow-sm border border-gray-100">
              <h3 class="text-xl font-semibold text-gray-800"><%= reg.eventId.name %></h3>
              <p class="text-gray-600 text-sm mb-1">
                From: <%= reg.userId.name %> (<%= reg.userId.email %>)
              </p>
              <p class="text-gray-600 text-sm mb-1">
                College: <%= reg.participants[0].college %> | Department: <%= reg.participants[0].branch %>
              </p>
              <p class="text-gray-700 mt-2"><%= reg.feedback.comment %></p>
            </div>
          <% } %>
        <% }) %>
      </div>
    <% } %>
  </div>
</main>

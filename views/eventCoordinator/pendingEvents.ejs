<%- include('../partials/eventCoordinatorHeader', { coordinator: coordinator }) %>

<main class="ml-0 md:ml-60 p-6 bg-gray-100 min-h-screen">
  <div class="max-w-5xl mx-auto bg-white rounded-2xl shadow-lg p-6 border border-gray-200">
    <h2 class="text-2xl font-bold text-gray-800 mb-6">Pending Events</h2>

    <% if (pendingEvents && pendingEvents.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse rounded-lg overflow-hidden">
          <thead class="bg-gray-200 text-gray-700">
            <tr>
              <th class="py-3 px-4 text-left">Event Name</th>
              <th class="py-3 px-4 text-left">Date</th>
              <th class="py-3 px-4 text-left">Venue</th>
              <th class="py-3 px-4 text-left">Department</th>
              <th class="py-3 px-4 text-left">Status</th>
              <th class="py-3 px-4 text-left">Reason</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% pendingEvents.forEach(event => { %>
              <tr class="hover:bg-gray-50">
                <td class="py-3 px-4 font-medium text-gray-900"><%= event.name %></td>
                <td class="py-3 px-4 text-gray-700"><%= event.dateFormatted || new Date(event.date).toDateString() %></td>
                <td class="py-3 px-4 text-gray-700"><%= event.venue %></td>
                <td class="py-3 px-4 text-gray-700"><%= event.department %></td>
                <td class="py-3 px-4">
                  <% if(event.status === "draft" || event.status === "pending"){ %>
                    <span class="px-3 py-1 rounded-full text-sm font-semibold bg-yellow-100 text-yellow-800">
                      Pending
                    </span>
                  <% } else if(event.status === "rejected"){ %>
                    <span class="px-3 py-1 rounded-full text-sm font-semibold bg-red-100 text-red-800">
                      Rejected
                    </span>
                  <% } %>
                </td>
                <td class="py-3 px-4 text-gray-700">
                  <% if(event.status === "rejected"){ %>
                    <%= event.rejectionNote || "No reason provided" %>
                  <% } else { %>
                    -
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p class="text-gray-600 text-center py-8">No pending events at the moment 🎉</p>
    <% } %>
  </div>
</main>

<%- include('../partials/eventCoordinatorHeader', { coordinator: coordinator }) %>

<main class="ml-0 md:ml-60 p-6 bg-gray-50 min-h-screen">
  <div class="max-w-6xl mx-auto bg-white rounded-2xl shadow-md p-6">

    <h2 class="text-3xl font-semibold mb-6 text-gray-800"><%= event.name %> - Registrations</h2>

    <div class="overflow-x-auto">
      <table class="min-w-full text-left">
        <thead>
          <tr class="border-b border-gray-200">
            <th class="px-4 py-3 text-sm font-medium text-gray-600">#</th>
            <th class="px-4 py-3 text-sm font-medium text-gray-600">Registered By</th>
            <th class="px-4 py-3 text-sm font-medium text-gray-600">Participants</th>
            <th class="px-4 py-3 text-sm font-medium text-gray-600">Payment Status</th>
          </tr>
        </thead>
        <tbody>
          <% if (!registrations || registrations.length === 0) { %>
            <tr>
              <td colspan="4" class="px-4 py-6 text-center text-gray-400 font-medium">No registrations yet.</td>
            </tr>
          <% } else { %>
            <% registrations.forEach((reg, index) => { %>
              <tr class="hover:bg-gray-50 transition-colors duration-200">
                <td class="px-4 py-3 text-gray-700 font-medium"><%= index + 1 %></td>
                <td class="px-4 py-3 text-gray-800">
                  <%= reg.userId ? reg.userId.name : '-' %> <br>
                  <span class="text-gray-500 text-sm"><%= reg.userId ? reg.userId.email : '-' %></span>
                </td>
                <td class="px-4 py-3 space-y-1">
                  <% reg.participants.forEach((p, pIndex) => { %>
                    <div class="p-2 bg-gray-50 rounded">
                      <p class="text-gray-700 font-medium">Participant <%= pIndex + 1 %>:</p>
                      <p class="text-gray-600 text-sm"><%= p.name %> | <%= p.email %> | <%= p.mobNo %> <% if(p.altMobNo){ %>| Alt: <%= p.altMobNo %><% } %></p>
                      <% if(p.college){ %><p class="text-gray-600 text-sm">College: <%= p.college %></p><% } %>
                      <% if(p.branch){ %><p class="text-gray-600 text-sm">Branch: <%= p.branch %></p><% } %>
                      <% if(p.semester){ %><p class="text-gray-600 text-sm">Semester: <%= p.semester %></p><% } %>
                    </div>
                  <% }) %>
                </td>
                <td class="px-4 py-3">
                  <span class="<%= reg.paymentStatus === 'paid' ? 'text-green-600' : 'text-red-600' %> font-semibold">
                    <%= reg.paymentStatus === 'paid' ? 'Paid' : 'Not Paid' %>
                  </span>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>

    <div class="mt-6">
      <a href="/event-coordinator/dashboard" class="text-blue-600 hover:underline font-medium">← Back to Dashboard</a>
    </div>
  </div>
</main>

<style>
  body {
    font-family: 'Inter', sans-serif;
    background-color: #f9fafb;
  }
</style>

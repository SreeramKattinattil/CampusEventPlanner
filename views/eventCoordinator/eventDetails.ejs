<%- include('../partials/eventCoordinatorHeader', { coordinator: coordinator }) %>

<main class="ml-0 md:ml-60 p-4 md:p-8 bg-gray-100 min-h-screen">
  <div class="max-w-7xl mx-auto bg-white rounded-2xl shadow-lg p-6">

    <h2 class="text-3xl font-bold mb-6"><%= event.name %> - Registrations</h2>

    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">#</th>
            <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Registered By</th>
            <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Participants</th>
            <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Payment Status</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% if(!registrations || registrations.length === 0){ %>
            <tr>
              <td colspan="4" class="px-4 py-4 text-center text-gray-500">
                No registrations yet.
              </td>
            </tr>
          <% } else { %>
            <% registrations.forEach((reg, index) => { %>
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-2"><%= index + 1 %></td>
                <td class="px-4 py-2">
                  <%= reg.userId ? reg.userId.name : '-' %> <br>
                  <span class="text-gray-500 text-sm"><%= reg.userId ? reg.userId.email : '-' %></span>
                </td>
                <td class="px-4 py-2">
                  <% reg.participants.forEach((p, pIndex) => { %>
                    <div class="mb-2 border-b border-gray-200 pb-1">
                      <strong>Participant <%= pIndex + 1 %>:</strong> <%= p.name %> | <%= p.email %> | <%= p.mobNo %> 
                      <% if(p.altMobNo) { %> | Alt: <%= p.altMobNo %> <% } %>
                      <% if(p.college) { %> | College: <%= p.college %> <% } %>
                      <% if(p.branch) { %> | Branch: <%= p.branch %> <% } %>
                      <% if(p.semester) { %> | Semester: <%= p.semester %> <% } %>
                    </div>
                  <% }) %>
                </td>
                <td class="px-4 py-2">
                  <span class="<%= reg.paymentStatus === 'paid' ? 'text-green-600 font-semibold' : 'text-red-600 font-semibold' %>">
                    <%= reg.paymentStatus === "paid" ? "Paid" : "Not Paid" %>
                  </span>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>

    <a href="/event-coordinator/dashboard" class="mt-6 inline-block text-blue-500 hover:underline">← Back to Dashboard</a>
  </div>
</main>

<%- include('../partials/eventCoordinatorHeader', { coordinator }) %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css" />

<main class="ml-0 md:ml-60 p-6 bg-gray-100 min-h-screen">
  <div class="max-w-3xl mx-auto bg-white p-6 rounded-2xl shadow-lg">
    <h2 class="text-2xl font-bold mb-4 text-gray-800">Add Event Memories</h2>

    <!-- Upload Form -->
    <form action="/event-coordinator/addMedia" method="POST" enctype="multipart/form-data" class="space-y-4">
      <div>
        <label class="block font-semibold text-gray-700 mb-1">Select Event</label>
        <select name="eventId" required class="w-full border rounded-lg p-2">
          <% events.forEach(ev => { %>
            <option value="<%= ev._id %>"><%= ev.name %></option>
          <% }) %>
        </select>
      </div>

      <div>
        <label class="block font-semibold text-gray-700 mb-1">Caption</label>
        <textarea name="caption" class="w-full border rounded-lg p-2" placeholder="Write something..."></textarea>
      </div>

      <div>
        <label class="block font-semibold text-gray-700 mb-1">Upload Files (Images/Videos)</label>
        <input type="file" name="mediaFiles" multiple accept="image/*,video/*" class="w-full border p-2 rounded-lg" />
      </div>

      <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-semibold w-full">
        Upload Memories
      </button>
    </form>

    <% if (success) { %>
      <p class="text-green-600 mt-3 text-center font-medium">Media uploaded successfully!</p>
    <% } %>

    <!-- Preview uploaded media -->
    <% if (mediaList && mediaList.length > 0) { %>
      <div class="mt-8 space-y-6">
        <% mediaList.forEach(post => { %>
          <div class="bg-gray-50 p-4 rounded-xl border shadow-sm">

            <p class="font-medium text-gray-700 mb-2"><%= post.caption || "Untitled" %></p>
            <p class="text-sm text-gray-500 mb-2">Event: <%= post.event?.name %></p>

            <div class="swiper mySwiper">
              <div class="swiper-wrapper">
                <% if (post.files && post.files.length) { %>
                  <% post.files.forEach(file => { %>
                    <div class="swiper-slide">
                      <% if (file.mediaType === 'image') { %>
                        <img src="<%= file.mediaUrl %>" class="w-full h-80 object-cover rounded-lg" />
                      <% } else { %>
                        <video src="<%= file.mediaUrl %>" controls class="w-full h-80 object-cover rounded-lg"></video>
                      <% } %>
                    </div>
                  <% }) %>
                <% } %>
              </div>
              <div class="swiper-pagination"></div>
              <div class="swiper-button-next"></div>
              <div class="swiper-button-prev"></div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.js"></script>
<script>
  const swipers = document.querySelectorAll('.mySwiper');
  swipers.forEach(swiperEl => {
    new Swiper(swiperEl, {
      loop: false,
      spaceBetween: 10,
      pagination: { el: swiperEl.querySelector('.swiper-pagination'), clickable: true },
      navigation: { nextEl: swiperEl.querySelector('.swiper-button-next'), prevEl: swiperEl.querySelector('.swiper-button-prev') },
    });
  });
</script>

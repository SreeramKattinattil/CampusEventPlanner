<h2 class="text-2xl font-bold mb-4"><%= event.name %> - Registered Users</h2>

<% if (!registrations || registrations.length === 0) { %>
  <p class="text-gray-600">No users have registered for this event yet.</p>
<% } else { %>
  <ul class="space-y-2">
    <% registrations.forEach(reg => { %>
      <li class="border p-2 rounded bg-gray-50">
        <p><strong>Name:</strong> <%= reg.user.name %></p>
        <p><strong>Email:</strong> <%= reg.user.email %></p>
        <p><strong>Mobile:</strong> <%= reg.user.mobile %></p>
        <p class="text-sm text-gray-500">Registered At: <%= reg.registeredAt.toLocaleString() %></p>
      </li>
    <% }) %>
  </ul>
<% } %>

<%- include("../partials/eventcoordinatorHeader", { coordinator }) %>

<main class="ml-60 p-8 bg-gradient-to-br from-gray-100 to-gray-200 min-h-screen">
  <div class="max-w-7xl mx-auto">
    <h1 class="text-4xl font-bold text-gray-800 mb-8">Welcome, <%= coordinator.name %>!</h1>

    <!-- Approved Events -->
    <section class="mb-8">
      <h2 class="text-3xl font-semibold mb-6 text-gray-700">Approved Events</h2>

      <% if (!approvedEvents || approvedEvents.length === 0) { %>
        <p class="text-gray-600 text-lg">No approved events.</p>
      <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% approvedEvents.forEach(event => { %>
            <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition">
              <div class="p-6">
                <h3 class="text-xl font-bold text-gray-800 mb-2"><%= event.name %></h3>
                <p class="text-gray-600 mb-2"><%= event.description || "No description" %></p>
                <p class="text-gray-500 text-sm mb-1"><strong>Date:</strong> <%= event.dateFormatted %></p>
                <p class="text-gray-500 text-sm mb-1"><strong>Venue:</strong> <%= event.venue %></p>
                <a href="/event-coordinator/eventDetails/<%= event._id %>" 
                   class="inline-block mt-3 w-full text-center bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 rounded-xl transition">
                  View Registrations
                </a>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>

    <!-- Pending Events -->
    <section class="mb-8">
      <h2 class="text-3xl font-semibold mb-6 text-gray-700">Pending Events</h2>

      <% if (!pendingEvents || pendingEvents.length === 0) { %>
        <p class="text-gray-600 text-lg">No pending events.</p>
      <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% pendingEvents.forEach(event => { %>
            <div class="bg-yellow-50 rounded-2xl shadow-md overflow-hidden hover:shadow-lg transition">
              <div class="p-6">
                <h3 class="text-xl font-bold text-gray-800 mb-2"><%= event.name %></h3>
                <p class="text-gray-600 mb-2"><%= event.description || "No description" %></p>
                <p class="text-gray-500 text-sm mb-1"><strong>Date:</strong> <%= event.dateFormatted %></p>
                <p class="text-gray-500 text-sm mb-1"><strong>Venue:</strong> <%= event.venue %></p>
                <span class="inline-block mt-2 text-yellow-700 font-semibold capitalize"><%= event.adminStatus || "Pending" %></span>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>

    <!-- Rejected Events -->
    <section>
      <h2 class="text-3xl font-semibold mb-6 text-gray-700">Rejected Events</h2>

      <% if (!rejectedEvents || rejectedEvents.length === 0) { %>
        <p class="text-gray-600 text-lg">No rejected events.</p>
      <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% rejectedEvents.forEach(event => { %>
            <div class="bg-red-50 rounded-2xl shadow-md overflow-hidden hover:shadow-lg transition">
              <div class="p-6">
                <h3 class="text-xl font-bold text-gray-800 mb-2"><%= event.name %></h3>
                <p class="text-gray-600 mb-2"><%= event.description || "No description" %></p>
                <p class="text-gray-500 text-sm mb-1"><strong>Date:</strong> <%= event.dateFormatted %></p>
                <p class="text-gray-500 text-sm mb-1"><strong>Venue:</strong> <%= event.venue %></p>
                <p class="text-red-600 font-semibold mt-2">
                  <%= event.rejectionNote || "No reason provided" %>
                </p>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>
  </div>
</main>

<style>
  body { font-family: 'Inter', sans-serif; }
</style>

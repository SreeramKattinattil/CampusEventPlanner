<%- include("../partials/eventcoordinatorHeader") %>

<main class="ml-60 p-8 bg-gradient-to-br from-gray-100 to-gray-200 min-h-screen">
  <div class="max-w-6xl mx-auto">
    <h1 class="text-4xl font-bold text-gray-800 mb-8">Welcome, <%= coordinator.name %>!</h1>

    <!-- Events Created by Coordinator -->
    <section class="mb-12">
      <h2 class="text-2xl font-semibold mb-4">Events You Created</h2>

      <% if (!createdEvents || createdEvents.length === 0) { %>
        <p class="text-gray-600">You have not created any events yet.</p>
      <% } else { %>
        <ul class="space-y-4">
          <% createdEvents.forEach(event => { %>
            <li class="p-4 bg-white rounded-xl shadow hover:shadow-lg transition">
              <h3 class="text-xl font-bold text-gray-800"><%= event.name %></h3>
              <p class="text-gray-700"><%= event.description || "No description provided." %></p>
              <p class="text-sm text-gray-500 mt-1">
                Date: <%= event.dateFormatted %> | Time: <%= event.time %> | Venue: <%= event.venue %>
              </p>
              <p class="text-sm text-gray-500">Reg Fee: ₹<%= event.regFee %></p>
              <p class="text-sm text-gray-500">Participants: <%= event.participants %></p>
              <a href="/event-coordinator/eventDetails/<%= event._id %>"
                 class="text-blue-600 hover:underline mt-2 inline-block">View Details</a>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>

    <!-- Faculty Approved Events -->
    <section>
      <h2 class="text-2xl font-semibold mb-4">Faculty Approved Events</h2>

      <% if (!facultyApprovedEvents || facultyApprovedEvents.length === 0) { %>
        <p class="text-gray-600">No approved events available.</p>
      <% } else { %>
        <ul class="space-y-4">
          <% facultyApprovedEvents.forEach(event => { %>
            <li class="p-4 bg-white rounded-xl shadow hover:shadow-lg transition">
              <h3 class="text-xl font-bold text-gray-800"><%= event.name %></h3>
              <p class="text-gray-700"><%= event.description || "No description provided." %></p>
              <p class="text-sm text-gray-500 mt-1">
                Date: <%= event.dateFormatted %> | Time: <%= event.time %> | Venue: <%= event.venue %>
              </p>
              <p class="text-sm text-gray-500">Reg Fee: ₹<%= event.regFee %></p>
              <p class="text-sm text-gray-500">Participants: <%= event.participants %></p>
              <a href="/event-coordinator/eventDetails/<%= event._id %>"
                 class="text-blue-600 hover:underline mt-2 inline-block">View Details</a>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>
  </div>
</main>

<style>
  body {
    font-family: 'Inter', sans-serif;
  }
</style>

<%- include('../partials/facultyHeader', { faculty: faculty }) %>

<main class="ml-0 md:ml-60 p-6 bg-gray-100 min-h-screen">
  <div class="bg-white rounded-2xl shadow-md p-6 border border-gray-200">
    <h2 class="text-2xl font-bold text-gray-800 mb-6">Pending Events</h2>

    <% if (events.length === 0) { %>
      <p class="text-gray-600">No events are currently waiting for approval.</p>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="min-w-full bg-white border border-gray-200 rounded-xl">
          <thead>
            <tr class="bg-gray-100 text-gray-700 text-left">
              <th class="p-3">Event Name</th>
              <th class="p-3">Date</th>
              <th class="p-3">Department</th>
              <th class="p-3">Coordinator</th>
              <th class="p-3">Status</th>
            </tr>
          </thead>
          <tbody>
            <% events.forEach(event => { %>
              <tr class="border-t border-gray-200 hover:bg-gray-50">
                <td class="p-3 font-medium"><%= event.name %></td>
                <td class="p-3"><%= new Date(event.date).toDateString() %></td>
                <td class="p-3"><%= event.department %></td>
                <td class="p-3">
                  <%= event.coordinator ? event.coordinator.name : 'Unassigned' %>
                </td>
                <td class="p-3 text-yellow-600 font-semibold capitalize"><%= event.status %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</main>

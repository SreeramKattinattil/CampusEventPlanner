<%- include('../partials/facultyHeader', { faculty, stats }) %>

<main class="ml-0 md:ml-60 p-6 bg-gray-100 min-h-screen">

  <div class="bg-white rounded-2xl shadow p-6 border border-gray-200 max-w-3xl mx-auto">
    <h2 class="text-2xl font-semibold mb-6 text-gray-800">Create Event</h2>

    <form action="/faculty/create-event" method="POST" enctype="multipart/form-data" class="space-y-4">

      <div>
        <label class="block text-gray-700 font-medium mb-1">Event Name</label>
        <input type="text" name="name" required class="w-full border px-3 py-2 rounded" />
      </div>

      <div>
        <label class="block text-gray-700 font-medium mb-1">Description</label>
        <textarea name="description" class="w-full border px-3 py-2 rounded"></textarea>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-gray-700 font-medium mb-1">Date</label>
          <input type="date" name="date" required class="w-full border px-3 py-2 rounded" />
        </div>
        <div>
          <label class="block text-gray-700 font-medium mb-1">Time</label>
          <input type="time" name="time" required class="w-full border px-3 py-2 rounded" />
        </div>
      </div>

      <div>
        <label class="block text-gray-700 font-medium mb-1">Venue</label>
        <input type="text" name="venue" required class="w-full border px-3 py-2 rounded" />
      </div>

      <div>
        <label class="block text-gray-700 font-medium mb-1">Registration Fee</label>
        <input type="number" name="regFee" required step="0.01" class="w-full border px-3 py-2 rounded" />
      </div>

      <div>
        <label class="block text-gray-700 font-medium mb-1">Participants</label>
        <input type="number" name="participants" required class="w-full border px-3 py-2 rounded" />
      </div>

      <div>
        <label class="block text-gray-700 font-medium mb-1">Contact Info</label>
        <input type="text" name="contactInfo" required class="w-full border px-3 py-2 rounded" />
      </div>

      <div>
        <label class="block text-gray-700 font-medium mb-1">Department</label>
        <select name="department" class="w-full border px-3 py-2 rounded">
          <option value="All">All</option>
          <option value="MCA">MCA</option>
          <option value="MBA">MBA</option>
          <option value="iMCA">iMCA</option>
          <option value="Btech.NASB">Btech.NASB</option>
          <option value="Btech.EEE">Btech.EEE</option>
          <option value="Btech.CE">Btech.CE</option>
          <option value="Btech.ME">Btech.ME</option>
          <option value="Btech.CSE">Btech.CSE</option>
          <option value="Btech.ECE">Btech.ECE</option>
        </select>
      </div>

      <!-- Coordinator Selection -->
      <div>
        <label class="block text-gray-700 font-medium mb-1">Event Coordinator</label>
        <select name="coordinatorId" required class="w-full border px-3 py-2 rounded">
          <option value="" disabled selected>Select Coordinator</option>
          <% coordinators.forEach(coord => { %>
            <option value="<%= coord._id %>"><%= coord.name %> - <%= coord.email %></option>
          <% }) %>
        </select>
      </div>

      <!-- Media Upload -->
      <div>
        <label class="block text-gray-700 font-medium mb-1">Upload Media</label>
        <input type="file" name="media" multiple class="w-full border px-3 py-2 rounded" />
      </div>

      <div>
        <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
          Create Event
        </button>
      </div>

    </form>
  </div>

</main>

<%- include('../partials/facultyHeader', { faculty, stats }) %>

<main class="ml-0 md:ml-60 p-6 bg-gray-100 min-h-screen">

  <div class="bg-white rounded-2xl shadow p-6 border border-gray-200">
    <h2 class="text-2xl font-semibold mb-6 text-gray-800">Rejected Events</h2>

    <% if (events && events.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm text-left border border-gray-200">
          <thead class="bg-gray-100">
            <tr>
              <th class="px-4 py-2">Event Name</th>
              <th class="px-4 py-2">Date</th>
              <th class="px-4 py-2">Coordinator</th>
              <th class="px-4 py-2">Rejection Reason</th>
            </tr>
          </thead>
          <tbody>
            <% events.forEach(event => { %>
              <tr class="border-t hover:bg-gray-50">
                <td class="px-4 py-2 font-medium text-gray-700"><%= event.name %></td>
                <td class="px-4 py-2 text-gray-600"><%= new Date(event.date).toLocaleDateString() %></td>
             <td class="px-4 py-2 text-gray-700">
  <% if (event.coordinator) { %>
    <%= event.coordinator.name %>
  <% } else { %>
    -
  <% } %>
</td>
<td class="px-4 py-2 text-red-600 font-semibold">
  <%= event.rejectionNote || "No reason provided" %>
</td>

              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p class="text-gray-500 text-sm mt-2">No rejected events found.</p>
    <% } %>
  </div>

</main>

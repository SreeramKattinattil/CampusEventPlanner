<%- include('../partials/facultyHeader', { faculty, stats }) %>

<main class="ml-60 p-6 bg-gray-100 min-h-screen">
  <div class="max-w-7xl mx-auto bg-white shadow rounded p-6">
    <h2 class="text-2xl font-bold mb-6">Event Coordinators</h2>

    <% if (coordinators.length === 0) { %>
      <p class="text-gray-600">No event coordinators found.</p>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="min-w-full border border-gray-200">
          <thead class="bg-gray-100">
            <tr>
              <th class="p-3 text-left border-b">Name</th>
              <th class="p-3 text-left border-b">Email</th>
              <th class="p-3 text-left border-b">Department</th>
            </tr>
          </thead>
          <tbody>
            <% coordinators.forEach(coordinator => { %>
              <tr class="hover:bg-gray-50">
                <td class="p-3 border-b"><%= coordinator.name %></td>
                <td class="p-3 border-b"><%= coordinator.email %></td>
                <td class="p-3 border-b"><%= coordinator.department %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</main>
